# supabase pooler url for dev
DATABASE_URL="postgresql://USER:PASSWORD@SUPABASE_HOST:6543/postgres?pgbouncer=true"

# school server, used instead of DATABASE_URL when set
# SCHOOL_DATABASE_URL="postgresql://inventory_app:STRONG_PASSWORD@school-postgres-host:5432/ceit_inventory"

# direct connection for prisma migrations only
# DIRECT_URL="postgresql://USER:PASSWORD@SUPABASE_HOST:5432/postgres"

# public address that goes into the qr codes
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# REQUEST_RATE_LIMIT_SECRET="at-least-32-random-characters"
# BORROWER_DATA_RETENTION_DAYS="365"

# min ms between opening a public form and submitting it, tests set this to 0
# FORM_TOKEN_MIN_AGE_MS="700"

# db connections per process (1-20)
# DB_POOL_MAX="5"

# borrowing rules (defaults shown)
# BORROW_MAX_ADVANCE_DAYS="3"        # how far ahead a reservation can be
# BORROW_MAX_LOAN_DAYS="7"           # max loan length
# BORROW_MAX_TOTAL_LOAN_DAYS="14"    # max length with extensions
# BORROW_MAX_ACTIVE_REQUESTS="3"     # open requests per student
# BORROW_PICKUP_GRACE_HOURS="2"      # uncollected reservations expire after this
# BORROW_PENDING_HOLD_HOURS="24"     # unhandled requests expire after this
