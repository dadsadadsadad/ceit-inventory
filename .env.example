# Current development connection. Use the Supabase PostgreSQL pooler URL while developing on Vercel.
DATABASE_URL="postgresql://USER:PASSWORD@SUPABASE_HOST:6543/postgres?pgbouncer=true"

# Optional school-local PostgreSQL connection. When set, it takes priority over DATABASE_URL.
# SCHOOL_DATABASE_URL="postgresql://inventory_app:STRONG_PASSWORD@school-postgres-host:5432/ceit_inventory"

# Optional direct Supabase PostgreSQL connection for Prisma migrations while using the pooler above.
# DIRECT_URL="postgresql://USER:PASSWORD@SUPABASE_HOST:5432/postgres"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
