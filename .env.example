# Current development connection. Use the Supabase PostgreSQL pooler URL while developing on Vercel.
DATABASE_URL="postgresql://USER:PASSWORD@SUPABASE_HOST:6543/postgres?pgbouncer=true"

# School-local runtime connection. Set this only on the school deployment.
# SCHOOL_DATABASE_URL="postgresql://inventory_app:STRONG_PASSWORD@school-postgres-host:5432/ceit_inventory"

# Direct migration-owner connection. It is used only by Prisma migration commands and takes priority there.
# DIRECT_URL="postgresql://USER:PASSWORD@SUPABASE_HOST:5432/postgres"

# The permanent public or school-LAN address encoded into printable QR labels.
# On Vercel, this takes priority over the automatically exposed production domain.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# REQUEST_RATE_LIMIT_SECRET="at-least-32-random-characters"
# BORROWER_DATA_RETENTION_DAYS="365"

# Maximum PostgreSQL connections per application process (default 5; allowed 1-20).
# Keep the combined limit across all running instances below the database pool limit.
# DB_POOL_MAX="5"

# Borrowing rules (optional; the values below are the defaults).
# BORROW_MAX_ADVANCE_DAYS="3"        # reservations: pickup within this many days
# BORROW_MAX_LOAN_DAYS="7"           # longest a student can keep equipment
# BORROW_MAX_TOTAL_LOAN_DAYS="14"    # longest a loan can run once staff extend it
# BORROW_MAX_ACTIVE_REQUESTS="3"     # open requests or loans per student number
# BORROW_PICKUP_GRACE_HOURS="2"      # an uncollected reservation releases the item after this
# BORROW_PENDING_HOLD_HOURS="24"     # an unhandled "borrow now" request stops holding the item
