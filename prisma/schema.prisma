generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ItemType {
  ASSET
  SUPPLY
}

enum ItemStatus {
  OK
  WORKING
  DEPLOYED
  DEFECTIVE
  NOT_TESTED
  RETIRED
  LOST
}

enum ItemCondition {
  EXCELLENT
  GOOD
  FAIR
  POOR
  FOR_REPAIR
}

enum AuditAction {
  CREATED
  UPDATED
  MOVED
  STATUS_CHANGED
  SCANNED
}

enum BorrowStatus {
  REQUESTED
  BORROWED
  RETURN_REQUESTED
  RETURNED
  DECLINED
}

enum MaintenancePriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum MaintenanceStatus {
  OPEN
  RESOLVED
}

enum PublicRequestKind {
  BORROW
  RETURN
}

enum UserRole {
  ADMINISTRATOR
  CUSTODIAN
  STAFF
  VIEWER
}

model Location {
  id          String          @id @default(uuid()) @db.Uuid
  name        String          @unique
  roomNumber  String?
  description String?
  isActive    Boolean         @default(true)
  items       InventoryItem[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model Category {
  id          String          @id @default(uuid()) @db.Uuid
  name        String          @unique
  description String?
  isActive    Boolean         @default(true)
  items       InventoryItem[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model InventoryItem {
  id              String           @id @default(uuid()) @db.Uuid
  assetTag        String?          @unique
  qrCode          String           @unique @default(cuid())
  name            String
  description     String?
  itemType        ItemType         @default(ASSET)
  isComputer      Boolean          @default(false)
  quantity        Int              @default(1)
  status          ItemStatus       @default(OK)
  condition       ItemCondition    @default(GOOD)
  manufacturer    String?
  model           String?
  serialNumber    String?          @unique
  purchaseDate    DateTime?
  purchasePrice   Decimal?         @db.Decimal(12, 2)
  notes           String?
  categoryId      String           @db.Uuid
  locationId      String           @db.Uuid
  category        Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  location        Location         @relation(fields: [locationId], references: [id], onDelete: Restrict)
  computer        Computer?
  auditEvents     InventoryAudit[]
  photos          InventoryItemPhoto[]
  borrowRequests  BorrowRequest[]
  maintenanceTickets MaintenanceTicket[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([locationId, status])
  @@index([categoryId])
  @@index([itemType])
}

model Computer {
  id              String             @id @default(uuid()) @db.Uuid
  itemId          String             @unique @db.Uuid
  operatingSystem String?
  osVersion       String?
  processor       String?
  memoryGb        Int?
  storageGb       Int?
  storageType     String?
  graphics        String?
  macAddress      String?            @unique
  ipAddress       String?
  lastCheckedAt   DateTime?
  item            InventoryItem      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  software        ComputerSoftware[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

model ComputerSoftware {
  id               String    @id @default(uuid()) @db.Uuid
  computerId       String    @db.Uuid
  name             String
  version          String?
  licenseKeyHint   String?
  licenseExpiresAt DateTime?
  installedAt      DateTime?
  computer         Computer  @relation(fields: [computerId], references: [id], onDelete: Cascade)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([computerId, name])
}

model InventoryAudit {
  id        String        @id @default(uuid()) @db.Uuid
  itemId    String        @db.Uuid
  action    AuditAction
  summary   String
  actorId   String?
  actorName String?
  metadata  Json?
  item      InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@index([itemId, createdAt])
}

model BorrowRequest {
  id                 String       @id @default(uuid()) @db.Uuid
  inventoryItemId    String       @db.Uuid
  borrowerName       String
  studentNumber      String
  contact            String
  purpose            String
  requestedQuantity  Int          @default(1)
  expectedReturnDate DateTime
  status             BorrowStatus @default(REQUESTED)
  staffNotes         String?
  requestedAt        DateTime     @default(now())
  processedAt        DateTime?
  returnedAt         DateTime?
  processedByName    String?
  returnedByName     String?
  returnRequestedAt  DateTime?
  returnRequestNotes String?
  personalDataExpiresAt DateTime
  inventoryItem      InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([inventoryItemId, status])
  @@index([status, requestedAt])
  @@index([status, returnRequestedAt])
  @@index([personalDataExpiresAt])
}

model PublicRequestAttempt {
  id              String            @id @default(uuid()) @db.Uuid
  fingerprint     String
  kind            PublicRequestKind
  windowStartedAt DateTime
  attempts        Int               @default(1)
  updatedAt       DateTime          @updatedAt

  @@unique([fingerprint, kind])
  @@index([updatedAt])
}

model InventoryItemPhoto {
  id              String        @id @default(uuid()) @db.Uuid
  inventoryItemId String        @db.Uuid
  fileName        String
  contentType     String
  byteSize        Int
  data            Bytes
  createdAt       DateTime      @default(now())
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([inventoryItemId, createdAt])
}

model MaintenanceTicket {
  id              String              @id @default(uuid()) @db.Uuid
  inventoryItemId String              @db.Uuid
  title           String
  description     String
  priority        MaintenancePriority @default(NORMAL)
  status          MaintenanceStatus   @default(OPEN)
  reportedByName  String?
  assignedToName  String?
  resolutionNotes String?
  openedAt        DateTime            @default(now())
  resolvedAt      DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  inventoryItem   InventoryItem       @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@index([inventoryItemId, status])
  @@index([status, priority, openedAt])
}

model User {
  id                   String        @id @default(uuid()) @db.Uuid
  email                String        @unique
  passwordHash         String
  role                 UserRole      @default(VIEWER)
  isActive             Boolean       @default(true)
  failedSignInCount    Int           @default(0)
  firstFailedSignInAt  DateTime?
  lockedUntil          DateTime?
  sessions             UserSession[]
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
}

model UserSession {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique
  userId    String   @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model DashboardNote {
  id            String   @id @default(uuid()) @db.Uuid
  scope         String   @unique @default("shared-dashboard")
  content       String   @default("")
  updatedByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
