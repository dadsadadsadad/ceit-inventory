generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ItemType {
  ASSET
  SUPPLY
}

enum ItemStatus {
  OK
  WORKING
  DEPLOYED
  DEFECTIVE
  NOT_TESTED
  RETIRED
  LOST
}

enum ItemCondition {
  EXCELLENT
  GOOD
  FAIR
  POOR
  FOR_REPAIR
}

enum AuditAction {
  CREATED
  UPDATED
  MOVED
  STATUS_CHANGED
  SCANNED
  DELETED
  REQUESTED
  BORROWED
  RETURNED
  DECLINED
  SIGNED_IN
  SIGNED_OUT
  EXPORTED
}

enum BorrowStatus {
  REQUESTED
  RESERVED
  BORROWED
  RETURN_REQUESTED
  RETURNED
  DECLINED
  CANCELLED
}

enum MaintenancePriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum MaintenanceStatus {
  OPEN
  RESOLVED
}

enum PublicRequestKind {
  BORROW
  RETURN
  ISSUE
  SIGN_IN
}

enum UserRole {
  ADMINISTRATOR
  STAFF
}

// kinds of custom fields
enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  YES_NO
  CHOICE
}

// rooms and storage areas
model Location {
  id           String          @id @default(uuid()) @db.Uuid
  name         String          @unique
  assetTagCode String?         @unique @db.VarChar(6)
  roomNumber   String?
  description  String?
  isActive     Boolean         @default(true)
  items        InventoryItem[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model Category {
  id           String          @id @default(uuid()) @db.Uuid
  name         String          @unique
  assetTagCode String?         @unique @db.VarChar(6)
  description  String?
  isActive     Boolean         @default(true)
  items        InventoryItem[]
  customFields CustomField[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model InventoryItem {
  id                 String               @id @default(uuid()) @db.Uuid
  assetTag           String?              @unique
  qrCode             String               @unique @default(cuid())
  name               String
  description        String?
  itemType           ItemType             @default(ASSET)
  isComputer         Boolean              @default(false)
  quantity           Int                  @default(1)
  status             ItemStatus           @default(OK)
  condition          ItemCondition        @default(GOOD)
  manufacturer       String?
  model              String?
  serialNumber       String?              @unique
  purchaseDate       DateTime?
  purchasePrice      Decimal?             @db.Decimal(12, 2)
  // stock only, empty uses the default of 5
  lowStockThreshold  Int?
  warrantyEndsAt     DateTime?
  // custom field answers keyed by CustomField id
  customFields       Json?
  notes              String?
  lastCheckedAt      DateTime?
  categoryId         String               @db.Uuid
  locationId         String               @db.Uuid
  category           Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  location           Location             @relation(fields: [locationId], references: [id], onDelete: Restrict)
  computer           Computer?
  auditEvents        InventoryAudit[]
  photos             InventoryItemPhoto[]
  borrowRequests     BorrowRequest[]
  maintenanceTickets MaintenanceTicket[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([locationId, status])
  @@index([categoryId])
  @@index([itemType])
  @@index([lastCheckedAt])
  @@index([updatedAt])
  @@index([warrantyEndsAt])
}

// staff events on the dashboard calendar
model CalendarEvent {
  id            String   @id @default(uuid()) @db.Uuid
  title         String
  notes         String?
  // date only
  eventDate     DateTime @db.Date
  createdByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([eventDate])
}

// custom fields staff can add to items
model CustomField {
  id         String          @id @default(uuid()) @db.Uuid
  label      String
  fieldType  CustomFieldType @default(TEXT)
  // options for CHOICE fields
  choices    String[]
  // null = all item types
  appliesTo  ItemType?
  // null = all categories
  categoryId String?         @db.Uuid
  category   Category?       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  sortOrder  Int             @default(0)
  isActive   Boolean         @default(true)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([isActive, sortOrder])
}

model Computer {
  id                  String             @id @default(uuid()) @db.Uuid
  itemId              String             @unique @db.Uuid
  operatingSystem     String?
  osVersion           String?
  processor           String?
  memoryGb            Int?
  storageGb           Int?
  storageType         String?
  graphics            String?
  macAddress          String?            @unique
  ipAddress           String?
  hardwareDescription String?
  softwareDescription String?
  lastCheckedAt       DateTime?
  item                InventoryItem      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  software            ComputerSoftware[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
}

model ComputerSoftware {
  id               String    @id @default(uuid()) @db.Uuid
  computerId       String    @db.Uuid
  name             String
  version          String?
  licenseKeyHint   String?
  licenseExpiresAt DateTime?
  // null = not set
  isLicensed       Boolean?
  installedAt      DateTime?
  computer         Computer  @relation(fields: [computerId], references: [id], onDelete: Cascade)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([computerId, name])
}

// audit log
model InventoryAudit {
  id          String         @id @default(uuid()) @db.Uuid
  itemId      String?        @db.Uuid
  entityType  String?
  entityId    String?
  entityLabel String?
  action      AuditAction
  summary     String
  actorId     String?
  actorName   String?
  metadata    Json?
  item        InventoryItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now())

  @@index([itemId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([createdAt])
}

model BorrowRequest {
  id                    String        @id @default(uuid()) @db.Uuid
  inventoryItemId       String        @db.Uuid
  borrowerName          String
  studentNumber         String
  contact               String
  purpose               String
  requestedQuantity     Int           @default(1)
  expectedReturnDate    DateTime
  startsAt              DateTime      @default(now())
  isReservation         Boolean       @default(false)
  approvedAt            DateTime?
  approvedByName        String?
  cancelledAt           DateTime?
  status                BorrowStatus  @default(REQUESTED)
  staffNotes            String?
  requestedAt           DateTime      @default(now())
  processedAt           DateTime?
  returnedAt            DateTime?
  processedByName       String?
  returnedByName        String?
  returnRequestedAt     DateTime?
  returnRequestNotes    String?
  remindedAt            DateTime?
  checkedOutItemStatus  ItemStatus?
  personalDataExpiresAt DateTime
  inventoryItem         InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([inventoryItemId, status])
  @@index([status, requestedAt])
  @@index([status, returnRequestedAt])
  @@index([personalDataExpiresAt])
  @@index([inventoryItemId, status, startsAt, expectedReturnDate])
  @@index([status, expectedReturnDate])
}

// rate limit buckets
model PublicRequestAttempt {
  id              String            @id @default(uuid()) @db.Uuid
  fingerprint     String
  kind            PublicRequestKind
  windowStartedAt DateTime
  attempts        Int               @default(1)
  updatedAt       DateTime          @updatedAt

  @@unique([fingerprint, kind])
  @@index([updatedAt])
}

model InventoryItemPhoto {
  id              String        @id @default(uuid()) @db.Uuid
  inventoryItemId String        @db.Uuid
  fileName        String
  contentType     String
  byteSize        Int
  data            Bytes
  createdAt       DateTime      @default(now())
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([inventoryItemId, createdAt])
}

// maintenance tickets
model MaintenanceTicket {
  id              String              @id @default(uuid()) @db.Uuid
  inventoryItemId String              @db.Uuid
  title           String
  description     String
  priority        MaintenancePriority @default(NORMAL)
  status          MaintenanceStatus   @default(OPEN)
  reportedByName  String?
  source          String              @default("STAFF") @db.VarChar(16)
  resolutionNotes String?
  openedAt        DateTime            @default(now())
  resolvedAt      DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  inventoryItem   InventoryItem       @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@index([inventoryItemId, status])
  @@index([status, priority, openedAt])
}

model User {
  id                  String        @id @default(uuid()) @db.Uuid
  email               String        @unique
  username            String        @unique
  passwordHash        String
  role                UserRole      @default(STAFF)
  isActive            Boolean       @default(true)
  failedSignInCount   Int           @default(0)
  firstFailedSignInAt DateTime?
  lockedUntil         DateTime?
  // email notification kinds this person wants, see lib/notification-kinds.ts
  notifyOn            String[]      @default(["borrowRequests", "returns", "repairs", "dailyLoans"])
  // event kinds that wait for the summary instead of sending right away
  notifyLater         String[]      @default([])
  // daily, weekdays, weekly or off
  summaryFrequency    String        @default("daily")
  // 0 = Sunday, only for weekly
  summaryDay          Int           @default(1)
  // morning or afternoon
  summaryTime         String        @default("morning")
  // chosen dashboard widgets and their order, see lib/dashboard-layout.ts, empty = default
  dashboardLayout     Json?
  sessions            UserSession[]
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
}

model UserSession {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique
  userId    String   @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model DashboardNote {
  id            String   @id @default(uuid()) @db.Uuid
  scope         String   @unique @default("shared-dashboard")
  content       String   @default("")
  updatedByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
