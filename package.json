{
  "name": "ceit-inventory",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm run build",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:db": "npm run db:check && prisma migrate status",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:check": "node scripts/check-db.cjs",
    "db:purge-borrower-data": "node scripts/purge-borrower-data.cjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@zxing/browser": "^0.2.1",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.23.0",
    "next": "^16.3.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/yauzl": "^3.4.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.3.0",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "archiver-utils": {
      "glob": {
        "minimatch": {
          "brace-expansion": "1.1.18"
        }
      }
    },
    "readdir-glob": {
      "minimatch": {
        "brace-expansion": "2.1.4"
      }
    },
    "exceljs": {
      "uuid": "11.1.1"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": {
        "brace-expansion": "5.0.9"
      }
    },
    "@eslint/eslintrc": {
      "js-yaml": "4.3.1"
    },
    "deepmerge-ts": "8.0.0",
    "nanoid": "3.3.18"
  }
}
